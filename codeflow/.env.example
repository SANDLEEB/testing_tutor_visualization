# Copy to .env and fill in. .env is gitignored.

# Postgres (matches docker-compose.yml defaults; port 5433 avoids colliding with
# any Postgres already running on the default 5432 on your machine)
DATABASE_URL=postgresql+psycopg://codeflow:codeflow@localhost:5433/codeflow

# Used to sign the NiceGUI session cookie (app.storage.user). Set to any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that get auto-promoted to the admin role on first signup/login.
# Needed to bootstrap the first admin account.
ADMIN_EMAILS=you@example.com

# Google SSO — leave blank to hide the "Sign in with Google" button.
# Create at: Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
# Authorized redirect URI: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft SSO — leave blank to hide the "Sign in with Microsoft" button.
# Create at: Azure Portal > Entra ID > App registrations > New registration
# Redirect URI (Web): http://localhost:8080/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# AI provider — powers AI Question Authoring, assignment source/test-suite drafting,
# and practice-answer feedback. Leave all three blank to disable AI features (pages
# show a setup notice instead of erroring). Tried in this order: Groq, Gemini, OpenRouter.

# Groq — free tier, no billing card required to start. Get a key at:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (Google AI Studio) — a direct API key tied to your Google account. Note:
# Google requires billing linked to the underlying Cloud project before granting
# ANY quota, even free-tier — see https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
